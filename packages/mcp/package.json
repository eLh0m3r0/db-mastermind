{
  "name": "dbmastermind-mcp",
  "version": "0.8.0",
  "description": "MCP server for databases (PostgreSQL, SQL Server, MySQL, MariaDB, SQLite): schema exploration, read-only queries and a Markdown knowledge base for Claude Code, Codex, Cursor and other agents. Part of DB Mastermind.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dbmastermind-mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "sqlserver",
    "mysql",
    "sqlite",
    "database",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eLh0m3r0/db-mastermind.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/eLh0m3r0/db-mastermind/tree/main/packages/mcp",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "mssql": "^12.7.10",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@dbmastermind/core": "*",
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "1.4.5-r.1"
  }
}
