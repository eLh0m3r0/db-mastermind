{
  "name": "db-mastermind",
  "private": true,
  "version": "0.1.0",
  "description": "Free & open-source database client with AI, ER diagrams, knowledge base and MCP server.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w packages/mcp && npm run build -w apps/desktop",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/mcp/tsconfig.json && tsc -p apps/desktop/tsconfig.node.json && tsc -p apps/desktop/tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down -v",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.15",
    "@rolldown/binding-darwin-x64": "1.2.15",
    "@rolldown/binding-linux-x64-gnu": "1.2.15",
    "@rolldown/binding-win32-arm64-msvc": "1.2.15",
    "@rolldown/binding-win32-x64-msvc": "1.2.15"
  }
}
