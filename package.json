{
  "name": "db-mastermind",
  "private": true,
  "version": "0.1.0",
  "description": "Free & open-source database client with AI, ER diagrams, knowledge base and MCP server.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w packages/mcp && npm run build -w apps/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down -v",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
